# Copia este archivo a .env y llena los valores reales (el .env NO se versiona).

# --- Meta / WhatsApp ---
# Usar el token PERMANENTE de System User, no el temporal del panel de pruebas
# (el temporal expira en ~24h y el bot deja de responder). Ver deploy/README-despliegue.md
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Bedrock ---
# Es un perfil de inferencia cross-region, no el ID base del modelo.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=us-east-1

# --- Catalogo de precios ---
# El bot lee catalogo.xlsx desde este bucket, asi cambiar un precio
# no obliga a reconstruir la imagen del contenedor.
CATALOGO_BUCKET=compureparo-bot-catalogo
CATALOGO_KEY=catalogo.xlsx
CATALOGO_TTL=300

# --- Escaladas ---
# Numero al que el bot avisa cuando no puede resolver algo (formato 573001234567).
# Si se deja vacio, no se envia aviso.
NUMERO_WILMAR=573008105537
